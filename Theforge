-- ===== Wait for Data =====
print("⏳ Waiting for Replica.Data...")
repeat task.wait(0.5) until Replica.Data and Replica.Data.Inventory and Replica.Data.Inventory.Equipments
print("✅ Replica.Data loaded!")

-- ===== Helper Functions =====
local function hasPickaxe(pickaxeName, inventory)
    if not inventory then return false end
    for _, item in pairs(inventory) do
        if typeof(item) == "table" and item.Name == pickaxeName then
            return true
        end
    end
    return false
end

local function getRaceEmoji(race)
    local raceEmojis = {
        ["Demon"] = "👿", ["Angel"] = "👼🏻", ["Archangel"] = "👼🏻👿",
        ["Shadow"] = "🌑", ["Developer"] = "💻", ["Golem"] = "🗿",
        ["Orc"] = "🟢", ["Minotaur"] = "🐂", ["Dragonborn"] = "🐉",
        ["Dwarf"] = "⛏️", ["Zombie"] = "🧟", ["Orc Lord"] = "👑🟢",
        ["Undead"] = "💀", ["Human"] = "👤", ["Elf"] = "🧝", ["Goblin"] = "👺"
    }
    return raceEmojis[race] or "❓"
end

local function getPickaxeShort(pickaxeName)
    local shortcuts = {
        ["Arcane Pickaxe"] = "AC",
        ["Magma Pickaxe"] = "MM",
        ["Demonic Pickaxe"] = "DM",
        ["Prismatic Pickaxe"] = "PRI",
        ["Frost Pickaxe"] = "FRO",
        ["Diamond Pickaxe"] = "DIA",
        ["Legendary Pickaxe"] = "LEG"
    }
    return shortcuts[pickaxeName] or pickaxeName:sub(1, 3):upper()
end

local function formatNumber(num)
    num = math.floor(num)
    if num >= 1000000 then
        return string.format("%.1fM", num / 1000000):gsub("%.0M", "M")
    elseif num >= 1000 then
        return string.format("%.1fk", num / 1000):gsub("%.0k", "k")
    else
        return tostring(num)
    end
end

-- ===== Main Loop =====
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("⛏️ Pickaxe Tracker Starting...")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("🎯 Config:")
print("  • Priority Pickaxe: " .. _G.Config.priorityPickaxe)
print("  • Target Pickaxe: " .. _G.Config.completionPickaxe)
print("  • Target Gold: " .. formatNumber(_G.Config.completionGold))
print("  • Max Level: " .. _G.Config.maxLevel)
print("  • Check Delay: " .. _G.Config.checkDelay .. "s")
print("  • Tracking: " .. table.concat(_G.Config.targetPickaxes, ", "))
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

while true do
    task.wait(_G.Config.checkDelay)
    
    pcall(function()
        if not Replica.Data or not Replica.Data.Inventory then return end
        
        local Gold = Replica.Data.Gold or 0
        local Race = Replica.Data.Race or "None"
        local Level = Replica.Data.Level or 0
        local inventory = Replica.Data.Inventory.Equipments
        
        hasDemonic = false
        hasPrismatic = false
        local pickaxeStatus = {}
        
        for _, targetName in ipairs(_G.Config.targetPickaxes) do
            local found = hasPickaxe(targetName, inventory)
            local shortName = getPickaxeShort(targetName)
            table.insert(pickaxeStatus, (found and "✅" or "❌") .. shortName)
            
            if found and targetName == _G.Config.completionPickaxe then
                hasDemonic = true
            end
            
            if found and targetName == _G.Config.priorityPickaxe then
                hasPrismatic = true
            end
        end
        
        -- Build message
        local message = string.format(
            "%s%s , 📊Lv.%d , 💰%s , %s",
            getRaceEmoji(Race),
            Race,
            Level,
            formatNumber(Gold),
            table.concat(pickaxeStatus, " ")
        )
        
        -- Build JSON
        local jsonData = string.format(
            '{"RACE":"%s","Level":%d,"Gold":"%s","ArcanePickaxe":"%s","MagmaPickaxe":"%s","DemonicPickaxe":"%s","FrostPickaxe":"%s","PrismaticPickaxe":"%s"}',
            Race,
            Level,
            formatNumber(Gold),
            hasPickaxe("Arcane Pickaxe", inventory) and "✅" or "❌",
            hasPickaxe("Magma Pickaxe", inventory) and "✅" or "❌",
            hasPickaxe("Demonic Pickaxe", inventory) and "✅" or "❌",
            hasPickaxe("Frost Pickaxe", inventory) and "✅" or "❌",
            hasPickaxe("Prismatic Pickaxe", inventory) and "✅" or "❌"
        )
        
        print("📤", message)
        
        pcall(function()
            _G.Horst_SetDescription(message, jsonData)
        end)
        
        -- เช็ค Priority Pickaxe (ยังเหมือนเดิม)
        if hasPrismatic then
            print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
            print("🌟 พบ " .. _G.Config.priorityPickaxe .. "!")
            print("🎯 เป้าหมายสำเร็จ! (Priority)")
            print("⏳ รอ " .. _G.Config.doneDelay .. " วินาที ก่อนส่ง DONE...")
            task.wait(_G.Config.doneDelay)
            
            pcall(function()
                _G.Horst_SetDescription(message, jsonData)
            end)
            task.wait(1)
            
            pcall(_G.Horst_AccountChangeDone)
            return true
        end
        
        -- เช็คเงื่อนไข Completion: ต้องมี Demonic + เงินครบ + Level > maxLevel
        if hasDemonic and Gold >= _G.Config.completionGold and Level > _G.Config.maxLevel then
            print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
            print("🎯 เป้าหมายสำเร็จ!")
            print("  ✅ มี " .. _G.Config.completionPickaxe)
            print("  ✅ เงิน " .. formatNumber(Gold) .. " / " .. formatNumber(_G.Config.completionGold))
            print("  ✅ เลเวล " .. Level .. " > " .. _G.Config.maxLevel)
            print("⏳ รอ " .. _G.Config.doneDelay .. " วินาที ก่อนส่ง DONE...")
            task.wait(_G.Config.doneDelay)
            
            pcall(function()
                _G.Horst_SetDescription(message, jsonData)
            end)
            task.wait(1)
            
            pcall(_G.Horst_AccountChangeDone)
            return true
        end
    end)
    
    if hasPrismatic then break end
    if hasDemonic and (Replica.Data.Gold or 0) >= _G.Config.completionGold and (Replica.Data.Level or 0) > _G.Config.maxLevel then break end
end

print("🏁 Script Finished!")
